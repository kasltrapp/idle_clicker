  data:
    title: Production Costs
    summary: Production costs let businesses spend currencies/resources on start,
      including partial batches and self-consuming producers.
    resourcePrefix: demo_costs
    sections:
    - heading: Project setup
      body: Add productionCost inputs, choose whether costs scale with production
        amount, allow partial affordability when needed, and use consumeOnProduce
        for expendable businesses.
